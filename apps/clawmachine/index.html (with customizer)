        function initToys() {
            const toysLayer = document.getElementById('toys-layer');
            if (!toysLayer) return;
            
            toysLayer.innerHTML = '';
            toysData = [];

            basePileLayout.forEach((pos, index) => {
                const id = index + 1;
                const slotEl = document.createElement('div');
                slotEl.id = `slot-toy-${id}`;
                slotEl.className = 'toy-slot slot-target';
                slotEl.style.zIndex = pos.z;
                slotEl.style.transform = `rotate(${pos.rot}deg)`;
                
                slotEl.setAttribute('data-slot-name', `Teddy ${id}`);
                toysLayer.appendChild(slotEl);

                const config = INITIAL_TOYS_CONFIG && INITIAL_TOYS_CONFIG[index] ? INITIAL_TOYS_CONFIG[index] : null;
                const defaultSrc = DEFAULT_TEDDY_SVGS[index % DEFAULT_TEDDY_SVGS.length];
                const src = config ? config.src : defaultSrc;
                const customSize = config ? config.customSize : null;

                const toyObj = {
                    id: id,
                    slotEl: slotEl,
                    baseX: pos.baseX,
                    baseBottom: pos.baseBottom,
                    x: pos.baseX,
                    bottom: pos.baseBottom,
                    size: customSize !== null ? customSize : globalToySize,
                    customSize: customSize,
                    active: true,
                    src: src
                };

                toysData.push(toyObj);
                renderToyImage(toyObj);
            });

            updateToyPositionsAndSizes();
        }

        function updateToyPositionsAndSizes() {
            const CENTER_X = 220;

            toysData.forEach(toy => {
                if (!toy.active) return;

                const currentSize = toy.customSize !== null ? toy.customSize : globalToySize;
                toy.size = currentSize;

                const shiftedX = CENTER_X + (toy.baseX - CENTER_X) * horizontalSpacingScale;
                const shiftedBottom = (toy.baseBottom * verticalSpacingScale) + toyYShift;

                toy.x = shiftedX;
                toy.bottom = shiftedBottom;

                toy.slotEl.style.width = `${currentSize}px`;
                toy.slotEl.style.height = `${currentSize}px`;
                toy.slotEl.style.left = `${shiftedX - (currentSize / 2)}px`;
                toy.slotEl.style.bottom = `${shiftedBottom}px`;
            });
        }

