<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arcade Claw Machine - Customizable</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Offside&display=swap" rel="stylesheet">
    
    <style id="game-styles">
        :root {
            --pink-bg: #ffa3c2;
            --header-magenta: #d11a5b;
            --glass-blue: #d2f0f8;
            --deck-coral: #ff7f97;
            --base-magenta: #c91854;
            --border-color: #222222;
            
            /* Calibration Variables */
            --glass-height: 350px;
            --glass-y-offset: 0px;
            --deck-y-offset: 0px;

            /* Custom Asset Scale & Position Variables */
            --claw-size: 120px;
            --claw-y-offset: 0px;

            --joystick-size: 110px;
            --joystick-y-offset: 0px;

            --button-size: 90px;
            --button-y-offset: 0px;
        }

        body {
            font-family: 'Offside', sans-serif;
            background-color: var(--pink-bg);
            background-image: radial-gradient(#ff7db0 15%, transparent 16%), radial-gradient(#ff7db0 15%, transparent 16%);
            background-size: 40px 40px;
            background-position: 0 0, 20px 20px;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            user-select: none;
        }

        .brand-font {
            font-family: 'Offside', sans-serif;
        }

        #token-card {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 80;
            background-color: #fff8cc;
            border: 4px solid #333;
            border-radius: 20px;
            box-shadow: 4px 4px 0px #222;
        }

        #machine-outer {
            position: relative;
            width: 440px;
            height: 680px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        #custom-machine-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 60;
            object-fit: contain;
            display: none;
        }

        #machine-container {
            width: 420px;
            height: 660px;
            background-color: transparent;
            border: 5px solid var(--border-color);
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 15px 0px rgba(0,0,0,0.2);
            overflow: hidden;
        }

        #top-marquee {
            height: 70px;
            background-color: var(--header-magenta);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            z-index: 10;
            background-size: cover;
            background-position: center;
            border-bottom: 4px solid var(--border-color);
        }

        #marquee-title {
            color: #ffffff;
            letter-spacing: 1.5px;
            white-space: nowrap;
            z-index: 2;
        }

        #glass-window {
            height: var(--glass-height);
            transform: translateY(var(--glass-y-offset));
            background-color: var(--glass-blue);
            position: relative;
            overflow: hidden;
            border-bottom: 4px solid var(--border-color);
            box-shadow: inset 0 0 25px rgba(255,255,255,0.8);
            z-index: 10;
        }

        #rail {
            position: absolute;
            top: 12px;
            left: 0;
            width: 100%;
            height: 8px;
            background-color: #555;
            border-bottom: 2px solid #222;
            z-index: 8;
        }

        #chute-dropzone {
            position: absolute;
            bottom: 0;
            left: 10px;
            width: 75px;
            height: 50px;
            background-color: #222;
            border-radius: 10px 10px 0 0;
            z-index: 5;
            opacity: 0.8;
        }

        #crane-system {
            position: absolute;
            top: 16px;
            left: 200px;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            z-index: 50;
        }

        #crane-cable {
            width: 4px;
            height: 20px;
            background: #222;
        }

        #crane-head-assembly {
            position: relative;
            width: 60px;
            height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: visible;
        }

        .custom-claw-img {
            width: var(--claw-size) !important;
            height: var(--claw-size) !important;
            max-width: none !important;
            max-height: none !important;
            object-fit: contain;
            position: absolute;
            top: var(--claw-y-offset);
            left: 50%;
            transform: translateX(-50%);
        }

        #css-claw-joint {
            width: 28px;
            height: 28px;
            background: #fff;
            border: 4px solid #222;
            border-radius: 50%;
            position: absolute;
            top: 0;
            z-index: 2;
        }

        .arm {
            position: absolute;
            top: 14px;
            width: 18px;
            height: 42px;
            border: 4px solid #222;
            border-radius: 0 0 8px 8px;
            transform-origin: top center;
            transition: transform 0.2s;
            background: #e0e0e0;
        }

        .arm-left { left: 8px; border-right: none; border-top: none; transform: rotate(25deg); }
        .arm-right { right: 8px; border-left: none; border-top: none; transform: rotate(-25deg); }
        .claw-closed .arm-left { transform: rotate(5deg); }
        .claw-closed .arm-right { transform: rotate(-5deg); }

        .toy-slot {
            position: absolute;
            bottom: 0px;
            user-select: none;
            z-index: 20;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: width 0.1s ease, height 0.1s ease, left 0.15s ease, bottom 0.15s ease;
        }

        .toy-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: drop-shadow(2px 3px 0px rgba(0,0,0,0.15));
        }

        #control-panel {
            background-color: var(--deck-coral);
            height: 90px;
            transform: translateY(var(--deck-y-offset));
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 0 20px;
            position: relative;
            z-index: 10;
            background-size: cover;
            background-position: center;
            border-bottom: 4px solid var(--border-color);
        }

        #joystick-container {
            width: 65px;
            height: 65px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            cursor: pointer;
            overflow: visible;
        }

        #custom-joystick-img {
            width: var(--joystick-size) !important;
            height: var(--joystick-size) !important;
            max-width: none !important;
            max-height: none !important;
            position: absolute;
            top: var(--joystick-y-offset);
            object-fit: contain;
            transition: transform 0.1s ease;
        }

        .default-joystick-base {
            width: 46px;
            height: 18px;
            background: #333;
            border-radius: 10px;
            position: relative;
            border: 3px solid #111;
        }

        .default-joystick-stick {
            width: 8px;
            height: 32px;
            background: #aaa;
            position: absolute;
            bottom: 10px;
            left: 16px;
            border: 2px solid #222;
        }

        .default-joystick-ball {
            width: 24px;
            height: 24px;
            background: #ff2a2a;
            border: 3px solid #222;
            border-radius: 50%;
            position: absolute;
            top: -18px;
            left: -10px;
            transition: transform 0.1s;
        }

        .tilt-left #custom-joystick-img, .tilt-left .default-joystick-ball { transform: translateX(-8px) rotate(-15deg); }
        .tilt-right #custom-joystick-img, .tilt-right .default-joystick-ball { transform: translateX(8px) rotate(15deg); }
        .tilt-up #custom-joystick-img, .tilt-up .default-joystick-ball { transform: translateY(-8px); }
        .tilt-down #custom-joystick-img, .tilt-down .default-joystick-ball { transform: translateY(8px); }

        #button-container {
            width: 65px;
            height: 65px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            cursor: pointer;
            overflow: visible;
        }

        #custom-button-img {
            width: var(--button-size) !important;
            height: var(--button-size) !important;
            max-width: none !important;
            max-height: none !important;
            position: absolute;
            top: var(--button-y-offset);
            object-fit: contain;
            transition: transform 0.08s ease;
        }

        .default-red-btn {
            width: 55px;
            height: 35px;
            background: #ff2a2a;
            border: 4px solid #222;
            border-radius: 50%;
            box-shadow: 0 6px 0 #990000;
            transition: all 0.08s;
        }

        .default-red-btn:active, .btn-pressed .default-red-btn, .btn-pressed#custom-button-img {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #990000;
        }

        #machine-base {
            flex: 1;
            background-color: var(--base-magenta);
            position: relative;
            z-index: 10;
            background-size: cover;
            background-position: center;
        }

        #prize-chute-exterior {
            position: absolute;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 80px;
            background: #222;
            border: 4px solid var(--border-color);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            overflow: visible;
        }

        #prize-out-display {
            position: absolute;
            bottom: -15px;
            width: 65px;
            height: 65px;
            z-index: 70;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform: translateY(-20px) scale(0);
            opacity: 0;
        }

        #prize-out-display.dispense {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        .hide-all-frames #machine-container,
        .hide-all-frames #control-panel,
        .hide-all-frames #top-marquee,
        .hide-all-frames #glass-window,
        .hide-all-frames #machine-base,
        .hide-all-frames #prize-chute-exterior {
            border-color: transparent !important;
            box-shadow: none !important;
        }

        .hide-inner-bg #glass-window,
        .hide-inner-bg #control-panel,
        .hide-inner-bg #top-marquee,
        .hide-inner-bg #machine-base {
            background-color: transparent !important;
            box-shadow: none !important;
        }

        .slot-highlight {
            outline: 3px dashed #00f0ff !important;
            outline-offset: 1px;
            position: relative;
        }

        .slot-highlight::after {
            content: attr(data-slot-name);
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: #00f0ff;
            color: #000;
            font-size: 9px;
            font-weight: 800;
            padding: 1px 4px;
            border-radius: 4px;
            white-space: nowrap;
            z-index: 100;
            pointer-events: none;
        }

        #customizer-panel {
            position: fixed;
            right: -420px;
            top: 0;
            width: 400px;
            height: 100vh;
            background: #ffffff;
            box-shadow: -5px 0 25px rgba(0,0,0,0.25);
            z-index: 200;
            transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

        #customizer-panel.open { right: 0; }
        .drawer-scroll::-webkit-scrollbar { width: 6px; }
        .drawer-scroll::-webkit-scrollbar-thumb { background: #d11a5b; border-radius: 10px; }

        #toast-notification {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #222;
            color: #fff;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 700;
            z-index: 300;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        }
        #toast-notification.show {
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <div id="token-card" class="p-3 flex items-center gap-3">
        <span class="text-3xl">🎟️</span>
        <div class="flex flex-col">
            <span class="brand-font text-xs text-gray-500 uppercase">Tokens</span>
            <span class="brand-font text-2xl text-gray-800 leading-none" id="token-count">5</span>
        </div>
        <button id="btn-add-tokens" class="ml-2 bg-yellow-400 hover:bg-yellow-500 text-black brand-font px-2 py-1 text-xs rounded-lg border-2 border-black active:translate-y-0.5">
            + Add
        </button>
    </div>

    <div id="machine-outer">
        <img id="custom-machine-overlay" alt="Custom Machine Overlay" src="" />

        <div id="machine-container" class="slot-target" data-slot-name="Outer Cabinet Frame">
            
            <div id="top-marquee" class="slot-target" data-slot-name="Header Marquee">
                <h1 id="marquee-title" class="brand-font text-3xl">PRIZE CLAW</h1>
            </div>

            <div id="glass-window" class="slot-target" data-slot-name="Glass Chamber">
                <div id="rail"></div>
                <div id="chute-dropzone"></div>

                <div id="toys-layer"></div>

                <div id="crane-system">
                    <div id="crane-cable"></div>
                    <div id="crane-head-assembly" class="slot-target" data-slot-name="Claw Head">
                        <img id="custom-claw-open" class="custom-claw-img hidden" alt="Claw Open" />
                        <img id="custom-claw-closed" class="custom-claw-img hidden" alt="Claw Closed" />

                        <div id="css-claw-body">
                            <div id="css-claw-joint"></div>
                            <div class="arm arm-left"></div>
                            <div class="arm arm-right"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="control-panel" class="slot-target" data-slot-name="Control Deck">
                <div id="joystick-container" class="slot-target" data-slot-name="Joystick UI">
                    <img id="custom-joystick-img" class="hidden" alt="Joystick" />
                    <div id="default-joystick" class="default-joystick-base">
                        <div class="default-joystick-stick"></div>
                        <div class="default-joystick-ball"></div>
                    </div>
                </div>

                <div id="dpad-controls" class="flex gap-1 items-center">
                    <button id="btn-left" class="w-9 h-9 bg-pink-500 border-2 border-black rounded-lg brand-font text-white text-sm active:bg-pink-600">◄</button>
                    <div class="flex flex-col gap-1">
                        <button id="btn-up" class="w-9 h-9 bg-pink-500 border-2 border-black rounded-lg brand-font text-white text-sm active:bg-pink-600">▲</button>
                        <button id="btn-down" class="w-9 h-9 bg-pink-500 border-2 border-black rounded-lg brand-font text-white text-sm active:bg-pink-600">▼</button>
                    </div>
                    <button id="btn-right" class="w-9 h-9 bg-pink-500 border-2 border-black rounded-lg brand-font text-white text-sm active:bg-pink-600">►</button>
                </div>

                <div id="button-container" class="slot-target" data-slot-name="Drop Button UI">
                    <img id="custom-button-img" class="hidden" alt="Drop Button" />
                    <button id="default-button" class="default-red-btn"></button>
                </div>
            </div>

            <div id="machine-base" class="slot-target" data-slot-name="Lower Base">
                <div id="prize-chute-exterior">
                    <div class="w-full h-3/4 bg-black rounded-t-md"></div>
                    <img id="prize-out-display" alt="Prize Won" />
                </div>
            </div>
        </div>
    </div>

    <button id="btn-toggle-drawer" class="fixed bottom-5 right-5 z-50 bg-pink-600 hover:bg-pink-700 text-white brand-font px-4 py-3 rounded-2xl border-4 border-black shadow-lg flex items-center gap-2 text-sm active:translate-y-1">
        <span>🎨 Customizer / Uploads</span>
    </button>

    <div id="customizer-panel">
        <div class="p-4 bg-pink-600 text-white flex justify-between items-center border-b-4 border-black">
            <h2 class="brand-font text-lg">Asset & Layout Customizer</h2>
            <button id="btn-close-drawer" class="text-white brand-font text-xl hover:text-gray-200">✕</button>
        </div>

        <div class="p-4 drawer-scroll flex-1 overflow-y-auto flex flex-col gap-5 text-sm">
            <div class="bg-emerald-50 p-3 rounded-xl border-2 border-emerald-400 flex flex-col gap-2">
                <span class="font-bold text-emerald-900 flex items-center gap-1">🚀 Export & Publish Clean Code</span>
                <p class="text-[11px] text-emerald-800 leading-tight">
                    Finished editing? Click below to generate a clean, ready-to-publish <code>index.html</code> with all your image assets embedded!
                </p>
                <div class="flex gap-2 mt-1">
                    <button id="btn-copy-clean-code" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white brand-font py-2 rounded-lg text-xs border-2 border-emerald-900 shadow active:translate-y-0.5">
                        📋 Copy Clean Code
                    </button>
                    <button id="btn-download-html" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white brand-font py-2 rounded-lg text-xs border-2 border-blue-900 shadow active:translate-y-0.5">
                        💾 Download index.html
                    </button>
                </div>
            </div>

            <!-- SPACING & LAYOUT DISTANCE CONTROLS -->
            <div class="bg-indigo-50 p-3 rounded-xl border-2 border-indigo-300 flex flex-col gap-2">
                <span class="font-bold text-indigo-900">📏 Toy Position & Distance Controls</span>
                <p class="text-[11px] text-gray-600 leading-tight">Adjust horizontal spacing, vertical row height, or shift the whole pile up/down.</p>

                <div class="flex flex-col gap-1 mt-1">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Pile Base Y-Offset (Up/Down Floor):</span>
                        <span id="val-toy-y-shift">0px</span>
                    </label>
                    <input type="range" id="slider-toy-y-shift" min="-40" max="80" value="0" class="w-full accent-indigo-600">
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Horizontal Distance / Spacing:</span>
                        <span id="val-toy-h-spacing">100%</span>
                    </label>
                    <input type="range" id="slider-toy-h-spacing" min="30" max="220" value="100" class="w-full accent-indigo-600">
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Vertical Row Distance:</span>
                        <span id="val-toy-v-spacing">100%</span>
                    </label>
                    <input type="range" id="slider-toy-v-spacing" min="30" max="220" value="100" class="w-full accent-indigo-600">
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Global Scale (All Toys):</span>
                        <span id="val-global-toy-size">52px</span>
                    </label>
                    <input type="range" id="slider-global-toy-size" min="20" max="100" value="52" class="w-full accent-indigo-600">
                </div>
            </div>

            <div class="bg-yellow-50 p-3 rounded-xl border-2 border-yellow-300 flex flex-col gap-2">
                <span class="font-bold text-yellow-900">✨ Layout Alignment & Transparency</span>
                
                <div class="flex items-center justify-between">
                    <label for="toggle-hide-inner-bg" class="text-xs text-gray-800 font-bold">Hide Inner Background Colors</label>
                    <input type="checkbox" id="toggle-hide-inner-bg" class="w-5 h-5 accent-pink-600 cursor-pointer">
                </div>

                <div class="flex items-center justify-between">
                    <label for="toggle-hide-all-borders" class="text-xs text-gray-800 font-bold">Hide Machine Outer Borders</label>
                    <input type="checkbox" id="toggle-hide-all-borders" class="w-5 h-5 accent-pink-600 cursor-pointer">
                </div>

                <div class="flex items-center justify-between">
                    <label for="toggle-highlights" class="text-xs text-blue-900 font-bold">Highlight Slot Guidelines</label>
                    <input type="checkbox" id="toggle-highlights" class="w-5 h-5 accent-blue-600 cursor-pointer">
                </div>

                <div class="mt-2 flex flex-col gap-1 border-t pt-2">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Glass Chamber Height:</span>
                        <span id="val-glass-height">350px</span>
                    </label>
                    <input type="range" id="slider-glass-height" min="200" max="450" value="350" class="w-full accent-pink-600">
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Glass Chamber Y-Offset:</span>
                        <span id="val-glass-y">0px</span>
                    </label>
                    <input type="range" id="slider-glass-y" min="-50" max="50" value="0" class="w-full accent-pink-600">
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Control Deck Y-Offset:</span>
                        <span id="val-deck-y">0px</span>
                    </label>
                    <input type="range" id="slider-deck-y" min="-50" max="50" value="0" class="w-full accent-pink-600">
                </div>

                <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold text-gray-700 flex justify-between">
                        <span>Claw Floor Depth Limit:</span>
                        <span id="val-claw-reach">270px</span>
                    </label>
                    <input type="range" id="slider-claw-reach" min="150" max="380" value="270" class="w-full accent-pink-600">
                </div>
            </div>

            <!-- INDIVIDUAL TOYS CONTROL PANEL -->
            <div class="bg-pink-50 p-3 rounded-xl border-2 border-pink-200 flex flex-col gap-3">
                <div class="flex justify-between items-center">
                    <span class="font-bold text-pink-900">🧸 Individual Toy Customization</span>
                </div>
                <p class="text-[11px] text-gray-500 leading-tight">Adjust each toy's specific size or upload unique graphics.</p>

                <div id="teddy-upload-rows" class="flex flex-col gap-2 max-h-80 overflow-y-auto pr-1"></div>
            </div>

            <div class="bg-pink-50 p-3 rounded-xl border-2 border-pink-200 flex flex-col gap-2">
                <span class="font-bold text-pink-900">🖼️ Upload Main Cabinet Frame Graphic</span>
                <p class="text-[11px] text-gray-500 leading-tight">Upload your template graphic.</p>
                <input type="file" id="upload-machine-body" accept="image/*" class="text-xs">
                <input type="text" id="url-machine-body" placeholder="Or paste image URL..." class="p-1.5 border rounded text-xs">
            </div>

            <div class="bg-gray-50 p-3 rounded-xl border-2 border-gray-200 flex flex-col gap-2">
                <span class="font-bold text-gray-800">🏷️ Header Marquee</span>
                <input type="text" id="input-banner-text" value="PRIZE CLAW" class="p-2 border rounded-lg text-sm font-bold" placeholder="Header Text..." />
                <div class="flex gap-2 items-center">
                    <label class="text-xs text-gray-500">Title Color:</label>
