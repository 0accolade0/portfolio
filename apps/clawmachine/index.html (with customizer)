                if (btnEl) btnEl.remove();

                cloneDoc.querySelectorAll('.slot-highlight').forEach(el => el.classList.remove('slot-highlight'));

                let scriptContent = cloneDoc.querySelector('#game-logic').innerHTML;
                scriptContent = scriptContent.replace(/let maxCraneY = \d+;/, `let maxCraneY = ${maxCraneY};`);
                scriptContent = scriptContent.replace(/let horizontalSpacingScale = [0-9.]+;/, `let horizontalSpacingScale = ${horizontalSpacingScale};`);
                scriptContent = scriptContent.replace(/let verticalSpacingScale = [0-9.]+;/, `let verticalSpacingScale = ${verticalSpacingScale};`);
                scriptContent = scriptContent.replace(/let toyYShift = -?\d+;/, `let toyYShift = ${toyYShift};`);
                scriptContent = scriptContent.replace(/let globalToySize = \d+;/, `let globalToySize = ${globalToySize};`);

                const exportedToysConfig = toysData.map(t => ({
                    customSize: t.customSize,
                    src: t.src
                }));

                scriptContent = scriptContent.replace(
                    /let INITIAL_TOYS_CONFIG = null;/,
                    `let INITIAL_TOYS_CONFIG = ${JSON.stringify(exportedToysConfig)};`
                );

                scriptContent = scriptContent.replace('setupCustomizer();', '// Customizer removed for production');
                cloneDoc.querySelector('#game-logic').innerHTML = scriptContent;

                return "<!DOCTYPE html>\n" + cloneDoc.outerHTML;
            };

            document.getElementById('btn-copy-clean-code').onclick = () => {
                const cleanCode = generateCleanHTML();
                navigator.clipboard.writeText(cleanCode).then(() => {
                    showToast("✨ Clean Production Code Copied!");
                });
            };

            document.getElementById('btn-download-html').onclick = () => {
                const cleanCode = generateCleanHTML();
                const blob = new Blob([cleanCode], { type: 'text/html' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'index.html';
                link.click();
                showToast("💾 index.html Downloaded!");
            };
        }

        function setupControls() {
            const joystickContainer = document.getElementById('joystick-container');
            const dropBtn = document.getElementById('button-container');

            window.onkeydown = (e) => {
                if (e.key === 'ArrowLeft') { keys.left = true; joystickContainer.className = 'slot-target tilt-left'; }
                if (e.key === 'ArrowRight') { keys.right = true; joystickContainer.className = 'slot-target tilt-right'; }
                if (e.key === 'ArrowUp') { keys.up = true; joystickContainer.className = 'slot-target tilt-up'; }
                if (e.key === 'ArrowDown') { keys.down = true; joystickContainer.className = 'slot-target tilt-down'; }
                if (e.key === ' ' && gameState === 'IDLE') {
                    dropBtn.classList.add('btn-pressed');
                    triggerDrop();
                }
            };

            window.onkeyup = (e) => {
                if (['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.key)) {
                    keys[e.key.replace('Arrow','').toLowerCase()] = false;
                    joystickContainer.className = 'slot-target';
                }
                if (e.key === ' ') dropBtn.classList.remove('btn-pressed');
            };

            const bindBtn = (id, key, tilt) => {
                const btn = document.getElementById(id);
                if (!btn) return;
                btn.onmousedown = btn.ontouchstart = (e) => {
                    e.preventDefault();
                    keys[key] = true;
                    joystickContainer.className = `slot-target ${tilt}`;
                };
                btn.onmouseup = btn.ontouchend = (e) => {
                    e.preventDefault();
                    keys[key] = false;
                    joystickContainer.className = 'slot-target';
                };
            };
            bindBtn('btn-left', 'left', 'tilt-left');
            bindBtn('btn-right', 'right', 'tilt-right');
            bindBtn('btn-up', 'up', 'tilt-up');
            bindBtn('btn-down', 'down', 'tilt-down');

            dropBtn.onclick = () => { if (gameState === 'IDLE') triggerDrop(); };

            document.getElementById('btn-add-tokens').onclick = () => {
                tokens += 5;
                document.getElementById('token-count').innerText = tokens;
                playTone(600, 0.1, 'square');
            };
        }

        function getHighestToyUnderClaw() {
            let hit = null;
            let highestBottom = -1;

            toysData.forEach(toy => {
                if (!toy.active) return;

                const halfToySize = toy.size / 2;
                const toyCenterX = toy.x;
                const dist = Math.abs(craneX - toyCenterX);
                if (dist < (halfToySize + 10)) {
                    if (toy.bottom > highestBottom) {
                        highestBottom = toy.bottom;
                        hit = toy;
                    }
                }
            });

            return hit;
        }

        function triggerDrop() {
            if (tokens <= 0) {
                alert("Out of tokens! Click '+ Add' to get more.");
                return;
            }
            tokens--;
            document.getElementById('token-count').innerText = tokens;

            grabbedToy = getHighestToyUnderClaw();
            
            if (grabbedToy) {
                targetDropY = Math.max(20, maxCraneY - (grabbedToy.bottom + 20));
            } else {
                targetDropY = maxCraneY;
            }

            gameState = 'DROPPING';
            playTone(300, 0.2, 'sawtooth');
            document.getElementById('prize-out-display').classList.remove('dispense');
        }

        function gameLoop() {
            const craneSys = document.getElementById('crane-system');
            const cable = document.getElementById('crane-cable');
            const clawHead = document.getElementById('crane-head-assembly');
            const clawOpenImg = document.getElementById('custom-claw-open');
            const clawClosedImg = document.getElementById('custom-claw-closed');

            switch(gameState) {
                case 'IDLE':
                    if (keys.left) craneX = Math.max(40, craneX - CLAW_SPEED);
                    if (keys.right) craneX = Math.min(GLASS_WIDTH - 20, craneX + CLAW_SPEED);
                    break;

                case 'DROPPING':
                    craneY += DROP_SPEED;
                    if (craneY >= targetDropY) {
                        craneY = targetDropY;
                        gameState = 'GRABBING';
                        clawHead.classList.add('claw-closed');

                        if (clawClosedImg.src) {
                            clawOpenImg.classList.add('hidden');
                            clawClosedImg.classList.remove('hidden');
                        }

                        setTimeout(() => {
                            if (grabbedToy) grabbedToy.active = false;
                            gameState = 'RETRACTING';
                        }, 500);
                    }
                    break;

                case 'RETRACTING':
                    craneY -= RETRACT_SPEED;
                    if (grabbedToy) {
                        const halfToySize = grabbedToy.size / 2;
                        grabbedToy.slotEl.style.bottom = 'auto';
                        grabbedToy.slotEl.style.top = `${craneY + 40}px`;
                        grabbedToy.slotEl.style.left = `${craneX - halfToySize}px`;
                    }
                    if (craneY <= 20) {
                        craneY = 20;
                        gameState = 'DELIVERING';
                    }
                    break;

                case 'DELIVERING':
                    if (craneX > CHUTE_X) craneX -= CLAW_SPEED;
                    else {
                        craneX = CHUTE_X;
                        gameState = 'RELEASING';
                        clawHead.classList.remove('claw-closed');

                        if (clawOpenImg.src) {
                            clawOpenImg.classList.remove('hidden');
                            clawClosedImg.classList.add('hidden');
                        }

                        if (grabbedToy) {
                            let toyY = parseInt(grabbedToy.slotEl.style.top);
                            const dropTimer = setInterval(() => {
                                toyY += 8;
                                grabbedToy.slotEl.style.top = `${toyY}px`;
                                if (toyY > 320) {
                                    clearInterval(dropTimer);
                                    grabbedToy.slotEl.style.display = 'none';
                                    dispensePrize(grabbedToy);
                                    grabbedToy = null;
                                }
                            }, 20);
                        }
                        setTimeout(() => { gameState = 'RESETTING'; }, 600);
                    }
                    if (grabbedToy) {
                        const halfToySize = grabbedToy.size / 2;
                        grabbedToy.slotEl.style.left = `${craneX - halfToySize}px`;
                    }
                    break;

                case 'RESETTING':
                    if (craneX < 200) craneX += CLAW_SPEED;
                    else {
                        craneX = 200;
                        gameState = 'IDLE';
                    }
                    break;
            }

            craneSys.style.left = `${craneX}px`;
            cable.style.height = `${craneY}px`;

            requestAnimationFrame(gameLoop);
        }

        function dispensePrize(toy) {
            const prizeImg = document.getElementById('prize-out-display');
            prizeImg.src = toy.src;
            prizeImg.style.width = `${toy.size}px`;
            prizeImg.style.height = `${toy.size}px`;
            prizeImg.classList.add('dispense');

            playTone(587.33, 0.1, 'triangle');
            setTimeout(() => playTone(880, 0.3, 'triangle'), 100);

            confetti({
                particleCount: 50,
                spread: 60,
                origin: { y: 0.8 }
            });
        }

        window.onload = () => {
            initToys();
            setupCustomizer();
            setupControls();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
</html>