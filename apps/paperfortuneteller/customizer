   ========================================================= */

const frameRotations={
"paper.png":0,
"firstfold.png":0,
"secondfold.png":0,
"thirdfold.png":0,
"fourthfold.png":0,
"fifthfold.png":0,
"sixthfold.png":0,
"seventhfold.png":0,
"eighthfold.png":0,
"ninthfold.png":0,
"verticalfold.png":0,
"topfold.png":0,
"horizontalfold.png":0,
"top.png":0,
"left.png":0,
"bottom.png":0,
"right.png":0
};


/* =========================================================
   ELEMENTS
   ========================================================= */

const frame=document.getElementById("frame"),
marker=document.getElementById("marker"),
text=document.getElementById("text"),
x=document.getElementById("x"),
y=document.getElementById("y"),
size=document.getElementById("size"),
rotate=document.getElementById("rotate"),
frameRotate=document.getElementById("frameRotate"),
paper=document.getElementById("paper"),
art=document.getElementById("art"),
layer=document.getElementById("markers"),
count=document.getElementById("count");

const MAX=60;
let currentMarker=0,copiedMarker=null;


/* =========================================================
   INITIALISE
   ========================================================= */

frames.forEach(f=>frame.add(new Option(f,f)));


/* =========================================================
   FRAME ORIENTATION
   ========================================================= */

function applyFrameRotation(){
 const r=frameRotations[frame.value]||0;
 art.style.transform=`translate(-50%,-50%) rotate(${r}deg)`;
 frameRotate.value=r;
}

frameRotate.onchange=()=>{
 frameRotations[frame.value]=+frameRotate.value;
 applyFrameRotation();
};

frame.onchange=()=>{
 currentMarker=0;
 paper.src=frame.value;
 frameRotate.value=frameRotations[frame.value]||0;
 updateMarkerList();
 applyFrameRotation();
};


/* =========================================================
   MARKER LIST
   ========================================================= */

function updateMarkerList(){
 marker.innerHTML="";
 marker.add(new Option("— Select Marker —",""));

 markers[frame.value].forEach((m,i)=>{
  marker.add(new Option(`Marker ${i+1} — ${texts[m.text]??m.text}`,i));
 });

 if(markers[frame.value].length){
  currentMarker=Math.min(currentMarker,markers[frame.value].length-1);
  marker.value=currentMarker;
  loadMarker();
 }else{
  text.value="";
  x.value="";
  y.value="";
  size.value="";
  rotate.value="";
  count.textContent="0 / 60";
 }

 render();
}

marker.onchange=()=>{
 if(marker.value==="")return;
 currentMarker=+marker.value;
 loadMarker();
};

function loadMarker(){
 const m=markers[frame.value][currentMarker];
 if(!m)return;

 text.value=texts[m.text]??m.text;
 x.value=m.x;
 y.value=m.y;
 size.value=m.size;
 rotate.value=m.rotate;
 count.textContent=`${text.value.length} / ${MAX}`;
}


/* =========================================================
   TEXT EDIT
   ========================================================= */

text.oninput=()=>{
 const m=markers[frame.value][currentMarker];
 if(!m)return;

 text.value=text.value.slice(0,MAX);
 texts[m.text]=text.value;

 count.textContent=`${text.value.length} / ${MAX}`;

 render();
 renderLibrary();
 updateMarkerList();

 marker.value=currentMarker;
};


/* =========================================================
   POSITION / SIZE / MARKER ROTATION
   ========================================================= */

["x","y","size","rotate"].forEach(id=>{
 document.getElementById(id).oninput=()=>{
  const m=markers[frame.value][currentMarker];
  if(!m)return;

  m[id]=+document.getElementById(id).value;
  render();
 };
});


/* =========================================================
   RENDER
   ========================================================= */

function render(){
 layer.innerHTML="";

 markers[frame.value].forEach((m,i)=>{
  const el=document.createElement("div");

  el.className="marker";
  el.textContent=texts[m.text]??m.text;

  el.style.left=m.x+"%";
  el.style.top=m.y+"%";
  el.style.fontSize=m.size+"px";
  el.style.transform=`translate(-50%,-50%) rotate(${m.rotate}deg)`;

  el.onmousedown=e=>{
   e.preventDefault();

   currentMarker=i;
   marker.value=i;
   loadMarker();

   const r=layer.getBoundingClientRect();

   const move=ev=>{
    m.x=Math.max(0,Math.min(100,((ev.clientX-r.left)/r.width)*100));
    m.y=Math.max(0,Math.min(100,((ev.clientY-r.top)/r.height)*100));

    x.value=m.x.toFixed(1);
    y.value=m.y.toFixed(1);

    render();
   };

   const up=()=>{
    removeEventListener("mousemove",move);
    removeEventListener("mouseup",up);
   };

   addEventListener("mousemove",move);
   addEventListener("mouseup",up);
  };

  layer.appendChild(el);
 });
}


/* =========================================================
   MARKER ACTIONS
   ========================================================= */

function addMarker(){
 const id="NEW_"+Date.now();

 markers[frame.value].push({
  x:50,
  y:50,
  text:id,
  size:12,
  rotate:0
 });

 texts[id]="NEW TEXT";

 currentMarker=markers[frame.value].length-1;

 updateMarkerList();
 marker.value=currentMarker;
 renderLibrary();
 render();
}

function duplicateMarker(){
 const m=markers[frame.value][currentMarker];
 if(!m)return;

 copiedMarker={...m};

 markers[frame.value].push({...copiedMarker});

 currentMarker=markers[frame.value].length-1;

 updateMarkerList();
 marker.value=currentMarker;
 render();
}

function pasteMarker(){
 if(!copiedMarker)return alert("Copy a marker first! 📋");

 markers[frame.value].push({...copiedMarker});

 currentMarker=markers[frame.value].length-1;

 updateMarkerList();
 marker.value=currentMarker;
 render();
}

function deleteMarker(){
 const a=markers[frame.value];

 if(!a.length)return;

 a.splice(currentMarker,1);

 currentMarker=Math.max(0,currentMarker-1);

 updateMarkerList();
 render();
}


/* =========================================================
   TEXT LIBRARY
   ========================================================= */

function renderLibrary(){
 const box=document.getElementById("textLibrary");

 box.innerHTML="";

 Object.keys(texts).forEach(id=>{
  const label=document.createElement("div");

  label.textContent="ID "+id;
  label.style.cssText="font-size:11px;color:#cfc5d2;margin:8px 0 3px";

  const input=document.createElement("input");

  input.maxLength=MAX;
  input.value=texts[id];

  input.oninput=()=>{
   input.value=input.value.slice(0,MAX);

   texts[id]=input.value;

   render();
   updateMarkerList();
  };

  box.appendChild(label);
  box.appendChild(input);
 });
}


/* =========================================================
   COPY ALL DATA
   ========================================================= */

function copyData(){
 const out=`/* FORTUNE TELLER TEXT MARKER DATA */

const textValues = ${JSON.stringify(texts,null,2)};

const textMarkers = ${JSON.stringify(markers,null,2)};

const frameRotations = ${JSON.stringify(frameRotations,null,2)};`;

 navigator.clipboard.writeText(out);

 alert("Copied! 📋");
}


/* =========================================================
   INITIAL LOAD
   ========================================================= */

paper.onload=()=>{
 applyFrameRotation();
 render();
};

addEventListener("resize",render);

updateMarkerList();
renderLibrary();
applyFrameRotation();
render();

</script>
