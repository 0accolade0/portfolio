<option value="0">0°</option>
<option value="90">90°</option>
<option value="180">180°</option>
<option value="270">270°</option>
</select>

<label>Selected Marker</label>
<select id="marker"></select>

<label>Text</label>
<input id="text" maxlength="60" placeholder="Max 60 characters">
<div class="count" id="count">0 / 60</div>

<div class="row">
<div><label>X (%)</label><input id="x" type="number" step=".1"></div>
<div><label>Y (%)</label><input id="y" type="number" step=".1"></div>
</div>

<div class="row">
<div><label>Font Size</label><input id="size" type="number"></div>
<div><label>Marker Rotation</label><input id="rotate" type="number"></div>
</div>

<button onclick="addMarker()">＋ Add Text Marker</button>
<button onclick="duplicateMarker()">⧉ Duplicate & Copy</button>
<button onclick="pasteMarker()">📌 Paste Marker</button>
<button onclick="deleteMarker()">Delete Selected</button>

<hr>

<h2>🔤 Text Library</h2>
<small>Same marker ID = same text everywhere.</small>
<div id="textLibrary"></div>

<hr>

<button onclick="copyData()">📋 Copy Marker Data</button>
