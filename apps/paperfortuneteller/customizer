
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fortune Teller Marker Editor</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#19151c;color:#fff;font-family:Arial,sans-serif;height:100vh;overflow:hidden}
#app{display:flex;width:100%;height:100%}
#stage{flex:1;position:relative;background:#29232d;overflow:hidden}
#art{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);transform-origin:center;display:inline-block}
#paper{display:block;max-width:90vw;max-height:90vh;width:auto;height:auto;user-select:none;pointer-events:none}
#markers{position:absolute;inset:0;pointer-events:none}
.marker{position:absolute;transform:translate(-50%,-50%);width:90px;min-height:20px;padding:3px 6px;background:#fff;color:#111;border:2px solid #ff6bbc;border-radius:6px;font-weight:bold;text-align:center;line-height:1.05;white-space:normal;overflow-wrap:break-word;cursor:grab;pointer-events:auto;user-select:none}
#panel{width:330px;background:#211c24;padding:16px;overflow:auto;border-left:2px solid #3b323f}
h2{margin:0 0 14px;font-size:18px}
label{display:block;font-size:11px;margin:10px 0 4px;color:#cfc5d2}
select,input,button{width:100%;padding:8px;border:0;border-radius:7px;font:inherit}
select,input{background:#332b36;color:#fff}
button{margin-top:9px;background:#ff6bbc;color:#111;font-weight:bold;cursor:pointer}
.row{display:grid;grid-template-columns:1fr 1fr;gap:7px}
hr{border:0;border-top:1px solid #403642;margin:16px 0}
small,.count{color:#a99fac}.count{font-size:10px;text-align:right;margin-top:3px}
</style>
</head>

